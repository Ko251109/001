{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gcloud",
        "~/Library/Keychains",
        "~/Library/Application Support/1Password",
        "~/Library/Application Support/com.apple.TCC"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.zshrc",
        "~/.bashrc",
        "~/.bash_profile",
        "~/.zprofile",
        "~/.profile"
      ],
      "allowRead": ["."],
      "allowWrite": ["."]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "statsig.anthropic.com",
        "sentry.io",
        "github.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.gnupg/*)"
    ]
  }
}
