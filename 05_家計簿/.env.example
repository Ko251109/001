# Gmail アカウント設定
# Gmailの「アプリパスワード」を使用してください
# 設定方法: Googleアカウント > セキュリティ > 2段階認証 > アプリパスワード

GMAIL_ACCOUNT_1_EMAIL=your_email1@gmail.com
GMAIL_ACCOUNT_1_PASSWORD=your_app_password_1

GMAIL_ACCOUNT_2_EMAIL=your_email2@gmail.com
GMAIL_ACCOUNT_2_PASSWORD=your_app_password_2

# Claude API キー
ANTHROPIC_API_KEY=your_anthropic_api_key

# 取得するメールの期間（日数）
EMAIL_FETCH_DAYS=30

# 出力ディレクトリ
OUTPUT_DIR=./output
